APP_NAME=ARES API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://ares:replace-me@localhost:5432/ares

# Commander Brief narration (optional). Leave LLM_PROVIDER empty for fully
# deterministic briefs. The API key must never be committed to the repository.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8.0
LLM_MODEL=
LLM_API_KEY=

UPLOAD_DIRECTORY=uploads
LOG_LEVEL=INFO
DEBUG=false
MAX_UPLOAD_SIZE=26214400
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
